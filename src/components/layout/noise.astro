<svg
  class="pointer-events-none fixed inset-0 z-0"
  style="width: 100%; height: 100%;"
>
  <filter id="noiseFilter">
    <feTurbulence
      type="turbulence"
      baseFrequency="0.5"
      numOctaves="1"
      seed="1"
      result="baseNoise"></feTurbulence>
    <feTurbulence
      type="turbulence"
      baseFrequency="0.5"
      numOctaves="1"
      seed="2"
      result="sparkleNoise"
    >
      <animate
        data-noise-motion
        attributeName="seed"
        values="2; 17; 5; 29; 11; 23; 7; 31; 13"
        calcMode="discrete"
        dur="2s"
        begin="indefinite"
        repeatCount="indefinite"></animate>
    </feTurbulence>
    <feComposite
      in="baseNoise"
      in2="sparkleNoise"
      operator="arithmetic"
      k2="0.7"
      k3="0.3"
      result="noise"></feComposite>
  </filter>
  <rect
    width="100%"
    height="100%"
    filter="url(#noiseFilter)"
    fill="black"
    opacity="0.15"></rect>
</svg>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const animations = document.querySelectorAll<SVGAnimationElement>(
    "[data-noise-motion]",
  );

  const updateNoiseMotion = () => {
    for (const animation of animations) {
      if (reducedMotion.matches) animation.endElement();
      else animation.beginElement();
    }
  };

  updateNoiseMotion();
  reducedMotion.addEventListener("change", updateNoiseMotion);
</script>
