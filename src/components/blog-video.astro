---
interface Props {
  /** Bunny Stream play or embed URL. */
  src: string;
  title: string;
  caption?: string;
  aspectRatio?: string;
  lang?: "en" | "de";
}

const {
  src,
  title,
  caption,
  aspectRatio = "16 / 9",
  lang = "en",
} = Astro.props;
const playLabel = lang === "de" ? "Video abspielen" : "Play video";
const pauseLabel = lang === "de" ? "Video pausieren" : "Pause video";
const embed = new URL(src);
if (embed.origin !== "https://player.mediadelivery.net") {
  throw new Error("BlogVideo requires a Bunny Stream player URL.");
}
embed.pathname = embed.pathname.replace(/^\/play\//, "/embed/");
for (const [key, value] of Object.entries({
  autoplay: "false",
  muted: "true",
  loop: "true",
  preload: "false",
  showSpeed: "false",
  rememberSettings: "false",
  // Let bandwidth determine quality rather than capping it to CSS dimensions.
  // A small player can still need a high-resolution stream on Retina screens.
  levelCap: "false",
}))
  embed.searchParams.set(key, value);
// Player.js requires unique sources when the same clip appears more than once.
embed.searchParams.set("instance", crypto.randomUUID());
---

<figure class="blog-video" data-no-lightbox>
  <blog-video data-play-label={playLabel} data-pause-label={pauseLabel}>
    <div class="video-frame">
      <iframe
        data-src={embed.href}
        title={title}
        style={{ "aspect-ratio": aspectRatio }}
        loading="lazy"
        allow="autoplay; encrypted-media"
        referrerpolicy="strict-origin-when-cross-origin"
        tabindex="-1"></iframe>
      <button type="button" disabled aria-label={`${playLabel}: ${title}`}>
        <svg
          class="play-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M9.24394 2.36758C7.41419 1.18362 5 2.49701 5 4.67639V19.3238C5 21.5032 7.41419 22.8166 9.24394 21.6326L20.5624 14.3089C22.2371 13.2253 22.2372 10.775 20.5624 9.69129L9.24394 2.36758Z"
          ></path>
        </svg>
        <svg
          class="pause-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M6.75 3C5.23122 3 4 4.23122 4 5.75V18.25C4 19.7688 5.23122 21 6.75 21H7.25C8.76878 21 10 19.7688 10 18.25V5.75C10 4.23122 8.76878 3 7.25 3H6.75Z"
          ></path>
          <path
            d="M16.75 3C15.2312 3 14 4.23122 14 5.75V18.25C14 19.7688 15.2312 21 16.75 21H17.25C18.7688 21 20 19.7688 20 18.25V5.75C20 4.23122 18.7688 3 17.25 3H16.75Z"
          ></path>
        </svg>
      </button>
    </div>
    <p class="video-status" role="status" hidden>
      {
        lang === "de"
          ? "Das Video kann nicht abgespielt werden. Bitte versuche es später noch einmal."
          : "Unable to play this video. Please try again later."
      }
    </p>
  </blog-video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Player = {
    on(event: string, callback: (data?: { code?: number }) => void): void;
    off(event: string): void;
    play(): void;
    pause(): void;
    destroy?(): void;
  };
  type PlayerApi = { Player: new (frame: HTMLIFrameElement) => Player };
  type PlayerWindow = Window & { playerjs?: PlayerApi };
  let apiPromise: Promise<PlayerApi> | undefined;

  function loadPlayerApi() {
    return (apiPromise ??= new Promise<PlayerApi>((resolve, reject) => {
      const existing = (window as PlayerWindow).playerjs;
      if (existing) return resolve(existing);
      const script = document.createElement("script");
      script.src =
        "https://assets.mediadelivery.net/playerjs/playerjs-latest.min.js";
      script.onload = () => {
        const api = (window as PlayerWindow).playerjs;
        if (api) resolve(api);
        else reject(new Error("Video controls unavailable"));
      };
      script.onerror = () => {
        apiPromise = undefined;
        script.remove();
        reject(new Error("Video controls unavailable"));
      };
      document.head.appendChild(script);
    }));
  }

  class BlogVideo extends HTMLElement {
    private cleanup?: () => void;

    async connectedCallback() {
      if (this.cleanup) return;
      const frame = this.querySelector("iframe")!;
      const button = this.querySelector("button")!;
      const status = this.querySelector<HTMLElement>(".video-status")!;
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const controller = new AbortController();
      const options = { signal: controller.signal };
      let player: Player | undefined;
      let ready = false;
      let playing = false;
      let visible = false;
      let wantsPlayback = !motion.matches;

      const update = () => {
        button.setAttribute(
          "aria-label",
          `${playing ? this.dataset.pauseLabel : this.dataset.playLabel}: ${frame.title}`,
        );
        button.toggleAttribute("data-playing", playing);
      };
      const sync = () => {
        if (!ready) return;
        if (wantsPlayback && visible && !document.hidden) player?.play();
        else player?.pause();
      };
      const observer = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting && entry.intersectionRatio >= 0.25;
          sync();
        },
        { threshold: [0, 0.25] },
      );
      observer.observe(frame);
      button.addEventListener(
        "click",
        () => {
          wantsPlayback = !playing;
          sync();
        },
        options,
      );
      document.addEventListener("visibilitychange", sync, options);
      motion.addEventListener(
        "change",
        () => {
          wantsPlayback = !motion.matches;
          sync();
        },
        options,
      );
      this.cleanup = () => {
        controller.abort();
        observer.disconnect();
        if (ready) player?.pause();
        for (const event of ["ready", "play", "pause", "ended", "error"])
          player?.off(event);
        player?.destroy?.();
        frame.removeAttribute("src");
        button.disabled = true;
      };

      try {
        const api = await loadPlayerApi();
        if (controller.signal.aborted) return;
        frame.src = frame.dataset.src!;
        player = new api.Player(frame);
        player.on("ready", () => {
          ready = true;
          button.disabled = false;
          sync();
        });
        player.on("play", () => {
          playing = true;
          status.hidden = true;
          update();
        });
        player.on("pause", () => {
          playing = false;
          update();
        });
        player.on("ended", () => {
          playing = false;
          update();
        });
        player.on("error", (error) => {
          playing = false;
          wantsPlayback = false;
          update();
          // Blocked autoplay can still be retried with a user gesture.
          if (error?.code !== 5) status.hidden = false;
        });
      } catch {
        if (!controller.signal.aborted) status.hidden = false;
      }
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get("blog-video"))
    customElements.define("blog-video", BlogVideo);
</script>

<style>
  blog-video {
    display: block;
  }
  .video-frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 0.5rem;
    background: var(--color-zinc-950);
  }
  .video-frame iframe {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: white;
    mix-blend-mode: difference;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  button:hover {
    opacity: 0.75;
  }
  button:focus-visible {
    outline: 2px solid white;
    outline-offset: -4px;
  }
  button svg {
    grid-area: 1 / 1;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      filter 200ms ease;
  }
  .play-icon,
  button[data-playing] .pause-icon {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }
  .pause-icon,
  button[data-playing] .play-icon {
    opacity: 0;
    transform: scale(0.7);
    filter: blur(2px);
  }
  @media (prefers-reduced-motion: reduce) {
    button svg {
      transition: none;
    }
  }
  [hidden] {
    display: none !important;
  }
  .blog-video figcaption {
    margin: 0.5rem auto 0;
  }
  .video-status {
    font-size: 0.875rem;
    color: var(--color-zinc-400);
  }
</style>
