---
interface Props {
  /** Selector used to find media in the post that should open in the lightbox */
  selector?: string;
}

const { selector = ".prose img, .prose video" } = Astro.props;
---

<div
  id="img-lightbox"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-zinc-950/95 backdrop-blur-sm outline-none"
  role="dialog"
  aria-modal="true"
  aria-label="Media lightbox"
  tabindex="-1"
>
  <button
    type="button"
    id="img-lightbox-close"
    class="absolute top-4 right-4 z-10 rounded-full p-2 text-zinc-400 backdrop-blur-md transition-colors hover:bg-zinc-800 hover:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400"
    aria-label="Close lightbox"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <div
    id="img-lightbox-content"
    class="flex h-full w-full flex-col items-center justify-center p-4 md:p-8"
  >
    <div
      class="relative flex max-h-[85vh] w-full max-w-5xl items-center justify-center"
    >
      <img
        id="img-lightbox-image"
        src=""
        alt=""
        class="max-h-[85vh] max-w-full rounded-lg object-contain"
      />
      <video
        id="img-lightbox-video"
        class="hidden max-h-[85vh] max-w-full rounded-lg object-contain"
        autoplay
        loop
        muted
        playsinline
      >
      </video>
    </div>

    <div
      id="img-lightbox-info"
      class="mt-4 w-full max-w-5xl space-y-2 pb-4 text-center select-text"
    >
      <p
        id="img-lightbox-caption"
        class="mx-auto line-clamp-3 max-w-prose text-sm leading-relaxed text-pretty text-zinc-400"
        aria-live="polite"
      >
      </p>
    </div>
  </div>
</div>

<style is:global>
  .prose :is(img, video)[data-lightbox-bound="true"] {
    cursor: zoom-in;
    outline: none;
    transition:
      scale 0.15s ease,
      box-shadow 0.15s ease;
  }

  .prose :is(img, video)[data-lightbox-bound="true"]:hover {
    scale: 1.02;
  }

  .prose
    :is(img, video)[data-lightbox-bound="true"]:focus-visible:not(
      [data-lightbox-restored-focus="true"]
    ) {
    outline: none;
    box-shadow:
      0px 5.5px 3.6px rgba(0, 0, 0, 0.024),
      0px 15.2px 10px rgba(0, 0, 0, 0.035),
      0px 36.5px 24.1px rgba(0, 0, 0, 0.046),
      0px 121px 80px rgba(0, 0, 0, 0.07),
      0 0 0 calc(5px + 0px) #101012,
      0 0 0 calc(7px + 0px) oklch(84.95% 0.00558 286.029);
  }
</style>

<script define:vars={{ selector }}>
  let isOpen = false;
  let lastFocusedMedia = null;
  let sourceVideo = null;
  let sourceVideoWasPlaying = false;
  let globalListenersBound = false;

  function initImageLightbox() {
    const lightbox = document.getElementById("img-lightbox");
    const lightboxImage = document.getElementById("img-lightbox-image");
    const lightboxVideo = document.getElementById("img-lightbox-video");
    const lightboxCaption = document.getElementById("img-lightbox-caption");
    const closeBtn = document.getElementById("img-lightbox-close");
    const infoPanel = document.getElementById("img-lightbox-info");

    if (!lightbox || !lightboxImage || !lightboxVideo || !lightboxCaption)
      return;

    const media = Array.from(document.querySelectorAll(selector)).filter(
      (item) => {
        if (item.closest("a")) return false; // don't hijack intentional links
        if (item.closest("[data-no-lightbox]")) return false;
        if (item.hasAttribute("data-no-lightbox")) return false;
        return true;
      },
    );

    function openLightbox(item) {
      lastFocusedMedia = item;
      const figure = item.closest("figure");
      const figcaption = figure?.querySelector("figcaption");
      const caption =
        figcaption?.textContent?.trim() ||
        item.getAttribute("alt") ||
        item.dataset.lightboxDescription ||
        "";

      if (item instanceof HTMLVideoElement) {
        sourceVideo = item;
        sourceVideoWasPlaying = !item.paused;
        item.pause();

        lightboxImage.classList.add("hidden");
        lightboxVideo.classList.remove("hidden");
        lightboxVideo.src = item.currentSrc || item.src;
        lightboxVideo.poster = item.poster;
        lightboxVideo.currentTime = item.currentTime;
      } else {
        lightboxVideo.classList.add("hidden");
        lightboxImage.classList.remove("hidden");
        lightboxImage.src = item.currentSrc || item.src;
        lightboxImage.alt = item.alt || "";
      }

      lightboxCaption.textContent = caption;
      lightboxCaption.style.display = caption ? "" : "none";

      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      isOpen = true;
      document.body.style.overflow = "hidden";
      lightbox.focus();

      if (item instanceof HTMLVideoElement) {
        lightboxVideo.play().catch(() => {});
      }
    }

    function closeLightbox() {
      if (!isOpen) return;

      if (sourceVideo) {
        sourceVideo.currentTime = lightboxVideo.currentTime;
        if (sourceVideoWasPlaying) sourceVideo.play().catch(() => {});
      }

      lightboxVideo.pause();
      lightboxVideo.removeAttribute("src");
      lightboxVideo.load();
      lightboxImage.removeAttribute("src");
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      isOpen = false;
      document.body.style.overflow = "";
      sourceVideo = null;
      sourceVideoWasPlaying = false;
      lastFocusedMedia?.setAttribute("data-lightbox-restored-focus", "true");
      lastFocusedMedia?.focus();
    }

    // Wire up each qualifying media element (dataset flag guards against
    // double-binding the same element on repeated init calls).
    media.forEach((item) => {
      if (item.dataset.lightboxBound === "true") return;
      item.dataset.lightboxBound = "true";
      item.tabIndex = 0;
      item.setAttribute("role", "button");
      const description =
        item.getAttribute("alt") ||
        item.getAttribute("aria-label") ||
        (item instanceof HTMLVideoElement ? "video" : "image");
      item.dataset.lightboxDescription = description;
      item.setAttribute("aria-label", `View full size: ${description}`);
      item.addEventListener("blur", () => {
        item.removeAttribute("data-lightbox-restored-focus");
      });

      item.addEventListener("click", () => openLightbox(item));
      item.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openLightbox(item);
        }
      });
    });

    if (globalListenersBound) return;
    globalListenersBound = true;

    closeBtn?.addEventListener("click", closeLightbox);

    // Click anywhere outside the image/caption/close button closes it.
    lightbox.addEventListener("click", (e) => {
      const target = e.target;
      if (target === closeBtn || closeBtn?.contains(target)) return;
      if (target === lightboxImage) return;
      if (target === lightboxVideo) return;
      if (infoPanel?.contains(target) || target === infoPanel) return;
      closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (isOpen && e.key === "Escape") closeLightbox();
    });
  }

  initImageLightbox();
  document.addEventListener("astro:after-swap", initImageLightbox);
</script>
